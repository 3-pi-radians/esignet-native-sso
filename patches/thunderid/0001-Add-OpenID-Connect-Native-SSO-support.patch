+func (suite *AuthzValidationTestSuite) TestValidateParams_DeviceSSO() {
+	allowed := *suite.oauthApp
+	allowed.Scopes = []string{"email", constants.ScopeDeviceSSO}
+
+	cases := []struct {
+		name    string
+		scope   string
+		app     *providers.OAuthClient
+		wantErr string
+	}{
+		{"ordinary request unaffected", "openid email", suite.oauthApp, ""},
+		{"allowed client with openid", "openid email device_sso", &allowed, ""},
+		{"client not registered for device_sso", "openid device_sso", suite.oauthApp, constants.ErrorInvalidScope},
+		{"device_sso without openid", "email device_sso", &allowed, constants.ErrorInvalidScope},
+		{"device_sso substring is not device_sso", "openid device_sso_extra", suite.oauthApp, ""},
+	}
+	for _, tc := range cases {
+		suite.Run(tc.name, func() {
+			params := suite.validParams()
+			params.Set(constants.RequestParamScope, tc.scope)
+			errCode, _ := ValidateAuthorizationRequestParams(params, tc.app, "")
+			assert.Equal(suite.T(), tc.wantErr, errCode)
+		})
+	}
+}
