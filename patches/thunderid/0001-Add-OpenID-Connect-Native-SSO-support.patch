+	Subject string
+	// AuthID identifies the authentication session. It is also emitted as the ID token's sid claim.
+	AuthID string
+	// ClientID is the client the device secret is issued to (the Super App).
+	ClientID string
+	// Scopes are the scopes granted to ClientID, excluding device_sso.
+	Scopes []string
+	// ACR is the authentication context class reference satisfied by the login.
+	ACR string
+	// Claims are the user claims the user consented to release.
+	Claims []string
+	// AuthTime is the time the user authenticated (seconds since epoch).
+	AuthTime int64
+	// CnfJkt is the RFC 7638 thumbprint of the DPoP key the device secret is bound to.
+	CnfJkt string
+	// AttributeCacheID references the cached user attributes of the login, so tokens issued through
+	// the device secret can release the same consented claims. Empty when nothing was cached.
+	AttributeCacheID string
+}
+
+// DeviceSecret is a device secret minted by a DeviceSecretProvider.
+type DeviceSecret struct {
+	// Value is the opaque device secret returned to the client.
+	Value string
+	// ExpiresAt is the expiry time of the device secret (seconds since epoch).
+	ExpiresAt int64
+}
+
+// DeviceSecretClaims is the authentication context recovered from a validated device secret.
+type DeviceSecretClaims struct {
+	JTI              string
+	Issuer           string
+	Subject          string
+	AuthID           string
+	ClientID         string
+	Scopes           []string
+	ACR              string
+	Claims           []string
+	AuthTime         int64
+	CnfJkt           string
+	AttributeCacheID string
+	IssuedAt         int64
+	ExpiresAt        int64
+}
