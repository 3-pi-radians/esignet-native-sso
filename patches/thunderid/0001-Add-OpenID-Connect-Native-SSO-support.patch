+// DeviceSecretProvider issues and validates OpenID Connect Native SSO device secrets
+// (https://openid.net/specs/openid-connect-native-sso-1_0.html). The device secret is opaque to
+// clients; the provider owns its format, protection (signing and encryption) and lifecycle.
+//
+// The engine calls GenerateDeviceSecret on the authorization_code grant when the authorization code
+// carries the device_sso scope, and ValidateDeviceSecret followed by MarkDeviceSecretUsed on the
+// token exchange grant when actor_token_type is urn:openid:params:token-type:device-secret.
+//
+// ValidateDeviceSecret and MarkDeviceSecretUsed must classify credential problems with the
+// ErrDeviceSecret* sentinel errors (wrapped or returned directly). Any other error is treated as an
+// internal failure and surfaced as server_error.
+type DeviceSecretProvider interface {
+	// GenerateDeviceSecret mints a device secret for the authenticated session described by req.
+	GenerateDeviceSecret(ctx context.Context, req *DeviceSecretRequest) (*DeviceSecret, error)
+
+	// ValidateDeviceSecret validates deviceSecret presented by requestingClientID and returns the
+	// authentication context it carries. It must verify integrity, issuer, expiry, required claims,
+	// revocation and session state, and that requestingClientID may redeem a secret minted for the
+	// original client.
+	ValidateDeviceSecret(ctx context.Context, requestingClientID, deviceSecret string) (
+		*DeviceSecretClaims, error)
+
+	// MarkDeviceSecretUsed records a successful redemption of the device secret by requestingClientID.
+	// It returns ErrDeviceSecretReplayed when the redemption policy forbids this redemption.
+	MarkDeviceSecretUsed(ctx context.Context, claims *DeviceSecretClaims, requestingClientID string) error
+}
