# Copy to keystore.properties (gitignored) to sign BOTH apps with the same release certificate.
# Without it, both apps are signed with the machine's debug keystore (~/.android/debug.keystore),
# which is also one shared certificate, so the signature-level SSO permission still works.
storeFile=/absolute/path/to/vendor-release.jks
storePassword=change-me
keyAlias=vendor
keyPassword=change-me
