<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with the same certificate can be granted this permission. It is declared
         in both apps (same signer, so Android accepts the duplicate) so install order does not matter. -->
    <permission
        android:name="io.mosip.nativesso.permission.SSO"
        android:description="@string/sso_permission_description"
        android:label="@string/sso_permission_label"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+) for the same-signer check on callers. -->
    <queries>
        <package android:name="io.mosip.nativesso.childapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NativeSso">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth redirect. Carries only the one-time authorization code (PKCE + DPoP bound). -->
        <activity
            android:name=".CallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="callback" android:scheme="io.mosip.nativesso.superapp" />
            </intent-filter>
        </activity>

        <!-- Native SSO handoff. Exported for binding by sibling apps, but bindable only with the
             signature-level permission; every call additionally re-verifies the caller. -->
        <service
            android:name=".SsoSigningService"
            android:exported="true"
            android:permission="io.mosip.nativesso.permission.SSO">
            <intent-filter>
                <action android:name="io.mosip.nativesso.action.SSO" />
            </intent-filter>
        </service>
    </application>
</manifest>
