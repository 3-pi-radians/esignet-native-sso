<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens and the device secret are stored encrypted with non-exportable Android Keystore keys. Keep
     every file on this device: no cloud backup and no device-to-device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
